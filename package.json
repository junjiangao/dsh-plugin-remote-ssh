{
  "name": "@junjiangao/dsh-plugin-remote-ssh",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "SSH host manager for the DeepSeek Harness Web UI: browse ~/.ssh/config, manage hosts, open each one in an independent official dsh-ssh remote-execution window, or mount remote workspaces into the current window.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjiangao/dsh-plugin-remote-ssh.git"
  },
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "ssh",
    "ssh-config",
    "remote",
    "remote-development"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "verify:static": "node verification/static-check.mjs",
    "verify:client": "node verification/client-audit.mjs",
    "verify:docs": "node verification/docs-audit.mjs",
    "verify:e2e": "node verification/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <3.19.0"
  }
}
